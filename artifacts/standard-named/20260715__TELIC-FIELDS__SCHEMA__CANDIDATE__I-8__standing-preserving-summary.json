    },
    "included_centers": {
      "type": "array"
    },
    "omitted_centers": {
      "type": "array"
    },
    "majority_or_common_positions": {
      "type": "array"
    },
    "minority_positions": {
      "type": "array"
    },
    "protected_conditions": {
      "type": "array"
    },
    "unresolved_disagreements": {
      "type": "array"
    },
    "source_links": {
      "type": "array"
    },
    "model_inferences": {
      "type": "array"
    },
    "generated_language": {
      "type": "array"
    },
    "participant_review": {
      "type": "object"
    },
    "corrections": {
      "type": "array"
    },
    "status": {
      "enum": [
        "draft",
        "participant_review",
        "active_for_scope",
        "corrected",
        "contested",
        "superseded",
        "released"
      ]
