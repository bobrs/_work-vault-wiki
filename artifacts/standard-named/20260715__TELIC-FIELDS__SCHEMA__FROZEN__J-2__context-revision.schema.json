{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telic:j2:schema:context-revision:0.1",
  "title": "ContextRevision",
  "type": "object",
  "required": [
    "context_id",
    "revision",
    "source_object_ids",
    "source_hashes",
    "correction_event_ids",
    "fingerprint",
    "created_at",
    "status"
  ],
  "properties": {
    "context_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_object_ids": {
      "type": "array",
      "minItems": 1
    },
    "source_hashes": {
      "type": "object"
    },
    "correction_event_ids": {
      "type": "array"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "contested",
        "released"
      ]
    }
  },
  "additionalProperties": false
}
