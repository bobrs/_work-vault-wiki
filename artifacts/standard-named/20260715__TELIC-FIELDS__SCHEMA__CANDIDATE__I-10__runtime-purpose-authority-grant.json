  "properties": {
    "grant_id": {
      "type": "string"
    },
    "assembly": {
      "type": "string"
    },
    "grantor": {
      "type": "string"
    },
    "grantee": {
      "type": "string"
    },
    "runtime_purpose": {
      "type": "string"
    },
    "allowed_operations": {
      "type": "array"
    },
    "prohibited_operations": {
      "type": "array"
    },
    "affected_centers": {
      "type": "array"
    },
    "authority_basis": {
      "type": "object"
    },
    "consent_basis": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "valid_time": {
      "type": "object"
    },
    "conditions": {
      "type": "array"
    },
    "review_triggers": {
      "type": "array"
    },
    "withdrawal_or_expiry": {
      "type": "object"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "conditional",
        "expired",
        "withdrawn",
        "contested",
        "suspended",
        "unknown"
      ]
    }
  },
  "additionalProperties": false
}
