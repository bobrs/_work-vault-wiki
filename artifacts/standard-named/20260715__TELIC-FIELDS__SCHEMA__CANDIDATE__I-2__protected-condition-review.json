{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protected-condition-review.schema.json",
  "title": "ProtectedConditionReview",
  "type": "object",
  "required": [
    "review_id",
    "condition",
    "source",
    "scope",
    "claimed_by",
    "authority_basis",
    "affected_centers",
    "current_status",
    "review_path",
    "valid_time",
    "reviewed_at"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object"
    },
    "claimed_by": {
      "type": "string"
    },
    "authority_basis": {
      "type": "object",
      "minProperties": 1
    },
    "affected_centers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_status": {
      "enum": [
        "protected_current_loop",
        "not_protected_current_loop",
        "contested",
        "insufficient_authority",
        "expired",
        "unknown"
      ]
    },
    "review_path": {
      "type": "object"
    },
    "valid_time": {
      "type": "object"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "model_candidate_only": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
