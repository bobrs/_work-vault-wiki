{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-rule-portfolio.schema.json",
  "title": "DecisionRulePortfolio",
  "type": "object",
  "required": [
    "portfolio_id",
    "assembly",
    "candidate_methods",
    "method_authority",
    "input_requirements",
    "weight_sources",
    "aggregation_rules",
    "noncompensatory_conditions",
    "uncertainties",
    "method_comparison",
    "selected_method",
    "selection_reason",
    "status"
  ],
  "properties": {
    "portfolio_id": {
      "type": "string"
    },
    "assembly": {
      "type": "string"
    },
    "candidate_methods": {
      "type": "array",
      "minItems": 1
    },
    "method_authority": {
      "type": "object"
    },
    "input_requirements": {
      "type": "object"
    },
    "weight_sources": {
      "type": "object"
    },
    "aggregation_rules": {
      "type": "object"
    },
    "noncompensatory_conditions": {
      "type": "array"
    },
    "uncertainties": {
      "type": "array"
    },
    "method_comparison": {
      "type": "array"
    },
    "selected_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "open",
        "reviewed",
        "selected",
        "contested",
        "superseded",
        "closed"
      ]
    }
  },
  "additionalProperties": false
}
