    },
    "model_version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array"
    },
    "assigned_roles": {
      "type": "array"
    },
    "allowed_tools": {
      "type": "array"
    },
    "prohibited_tools": {
      "type": "array"
    },
    "operation_limits": {
      "type": "array"
    },
    "data_limits": {
      "type": "array"
    },
    "action_limits": {
      "type": "array"
    },
    "required_confirmation": {
      "type": "object"
    },
    "required_human_reentry": {
      "type": "object"
    },
    "reversibility": {
      "type": "object"
    },
    "logging": {
      "type": "object"
    },
    "status": {
      "enum": [
        "active",
        "conditional",
        "suspended",
        "expired",
        "withdrawn",
        "contested",
        "unknown"
      ]
