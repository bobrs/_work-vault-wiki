{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-recommendation.schema.json",
  "title": "ModelRecommendation",
  "type": "object",
  "required": [
    "recommendation_id",
    "model_instance",
    "assigned_role",
    "based_on",
    "recommended_route",
    "alternatives",
    "decision_rule",
    "uncertainty",
    "authority",
    "status"
  ],
  "properties": {
    "recommendation_id": {
      "type": "string"
    },
    "model_instance": {
      "type": "string"
    },
    "assigned_role": {
      "const": "recommend"
    },
    "based_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "recommended_route": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_rule": {
      "type": "string"
    },
    "uncertainty": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "required": [
        "recommendation",
        "authorization",
        "execution"
      ],
      "properties": {
        "recommendation": {
          "type": "boolean"
        },
        "authorization": {
          "const": false
        },
        "execution": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "contested",
        "superseded",
        "expired"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
