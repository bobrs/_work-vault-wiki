{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-link-coordination-record.schema.json",
  "title": "TraceLinkCoordinationRecord",
  "type": "object",
  "required": [
    "coordination_id",
    "environment",
    "traces",
    "links",
    "participants",
    "coordination_purpose",
    "central_controller",
    "authority",
    "correction",
    "decay",
    "status"
  ],
  "properties": {
    "coordination_id": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "relation",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "supports",
              "contradicts",
              "corrects",
              "derives_from",
              "revision_of",
              "replaces",
              "depends_on",
              "triggers",
              "blocks",
              "routes_to",
              "summarizes",
              "annotates",
              "releases",
              "other"
            ]
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordination_purpose": {
      "type": "string"
    },
    "central_controller": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": "object"
    },
    "correction": {
      "type": "object"
    },
    "decay": {
      "type": "object"
    },
    "status": {
      "enum": [
        "active",
        "conditional",
        "contested",
        "completed",
        "archived",
        "released"
      ]
    }
  },
  "additionalProperties": false
}
