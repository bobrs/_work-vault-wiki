{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-trail-witness.schema.json",
  "title": "SemanticTrailWitness",
  "type": "object",
  "required": [
    "witness_id",
    "scope",
    "source_events",
    "traces",
    "memory_states",
    "retrieval_grants",
    "assertions",
    "corrections",
    "salience",
    "coordination_links",
    "transfers",
    "forgetting",
    "contamination",
    "actions",
    "consequences",
    "completeness",
    "generated_from_events",
    "event_ids",
    "generated_at"
  ],
  "properties": {
    "witness_id": {
      "type": "string"
    },
    "witness_version": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "source_events": {
      "type": "array"
    },
    "traces": {
      "type": "array"
    },
    "memory_states": {
      "type": "array"
    },
    "retrieval_grants": {
      "type": "array"
    },
    "assertions": {
      "type": "array"
    },
    "corrections": {
      "type": "array"
    },
    "salience": {
      "type": "array"
    },
    "coordination_links": {
      "type": "array"
    },
    "transfers": {
      "type": "array"
    },
    "forgetting": {
      "type": "array"
    },
    "contamination": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "consequences": {
      "type": "array"
    },
    "completeness": {
      "enum": [
        "complete_for_scope",
        "partial_known_gaps",
        "partial_unknown_gaps",
        "contested"
      ]
    },
    "generated_from_events": {
      "const": true
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
