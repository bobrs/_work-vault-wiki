{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgetting-release-record.schema.json",
  "title": "ForgettingReleaseRecord",
  "type": "object",
  "required": [
    "forgetting_id",
    "trace",
    "basis",
    "requested_by",
    "authority",
    "actions",
    "effective_at",
    "descendants",
    "surviving_witness",
    "surviving_obligations",
    "verification",
    "status"
  ],
  "properties": {
    "forgetting_id": {
      "type": "string"
    },
    "trace": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "reduce_salience",
          "remove_from_active_retrieval",
          "archive",
          "restrict",
          "seal",
          "release",
          "delete_content",
          "delete_derivatives",
          "preserve_deletion_witness",
          "transfer_custody",
          "other"
        ]
      }
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "descendants": {
      "type": "object"
    },
    "surviving_witness": {
      "type": "object"
    },
    "surviving_obligations": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    },
    "status": {
      "enum": [
        "requested",
        "approved",
        "in_progress",
        "partial",
        "completed",
        "contested",
        "failed"
      ]
    }
  },
  "additionalProperties": false
}
