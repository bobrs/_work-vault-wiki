{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fork-exit-record.schema.json",
  "title": "ForkExitRecord",
  "type": "object",
  "required": [
    "fork_exit_id",
    "source_loop",
    "departing_centers",
    "remaining_centers",
    "reason",
    "records",
    "assets",
    "obligations",
    "authority",
    "shared_infrastructure",
    "privacy",
    "transition",
    "repair",
    "status"
  ],
  "properties": {
    "fork_exit_id": {
      "type": "string"
    },
    "source_loop": {
      "type": "string"
    },
    "departing_centers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "remaining_centers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "array",
      "minItems": 1
    },
    "records": {
      "type": "object"
    },
    "assets": {
      "type": "object"
    },
    "obligations": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "shared_infrastructure": {
      "type": "object"
    },
    "privacy": {
      "type": "object"
    },
    "transition": {
      "type": "object"
    },
    "repair": {
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "negotiating",
        "active",
        "completed",
        "contested",
        "failed",
        "released"
      ]
    },
    "lineage_preserved": {
      "const": true
    },
    "shared_future_authority_presumed": {
      "const": false
    }
  },
  "additionalProperties": false
}
