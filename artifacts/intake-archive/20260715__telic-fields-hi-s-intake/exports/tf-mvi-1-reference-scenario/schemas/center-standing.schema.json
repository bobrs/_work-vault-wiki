{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telic:hi-s:schema:center-standing:0.1",
  "title": "CenterStanding",
  "type": "object",
  "required": [
    "id",
    "center_type",
    "standing_basis",
    "role",
    "scope",
    "representation_source",
    "authority",
    "consent_relation",
    "correction_route",
    "review",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "center_type": {
      "enum": [
        "person",
        "group",
        "community",
        "institution",
        "public_authority",
        "operator",
        "provider",
        "future_affected_center",
        "ecological_or_material_representation",
        "other"
      ]
    },
    "standing_basis": {
      "type": "array",
      "minItems": 1
    },
    "role": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "representation_source": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "consent_relation": {
      "type": "object"
    },
    "correction_route": {
      "type": "object"
    },
    "review": {
      "type": "object"
    },
    "status": {
      "enum": [
        "active",
        "active_with_conditions",
        "pending",
        "contested",
        "withdrawn",
        "expired",
        "unknown"
      ]
    }
  },
  "additionalProperties": false
}
