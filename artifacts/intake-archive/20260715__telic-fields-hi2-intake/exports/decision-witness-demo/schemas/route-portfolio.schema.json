{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-portfolio.schema.json",
  "title": "RoutePortfolio",
  "type": "object",
  "required": [
    "portfolio_id",
    "routes",
    "selection_logic",
    "shared_conditions",
    "branch_conditions",
    "review_schedule",
    "authority",
    "status"
  ],
  "properties": {
    "portfolio_id": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "selection_logic": {
      "type": "object"
    },
    "shared_conditions": {
      "type": "array"
    },
    "branch_conditions": {
      "type": "array",
      "minItems": 1
    },
    "review_schedule": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "minProperties": 1
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "paused",
        "completed",
        "released"
      ]
    },
    "activated_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_plurality": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
