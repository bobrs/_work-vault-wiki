{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction-record.schema.json",
  "title": "CorrectionRecord",
  "type": "object",
  "required": [
    "correction_id",
    "target_record",
    "target_version",
    "corrected_by",
    "grounds",
    "correction_type",
    "new_value",
    "valid_time_effect",
    "recorded_at",
    "authority"
  ],
  "properties": {
    "correction_id": {
      "type": "string",
      "pattern": "^urn:telic:[a-z0-9][a-z0-9._-]*:[a-z][a-z0-9_-]*:[0-9a-fA-F-]{36}$"
    },
    "target_record": {
      "type": "string",
      "pattern": "^urn:telic:[a-z0-9][a-z0-9._-]*:[a-z][a-z0-9_-]*:[0-9a-fA-F-]{36}$"
    },
    "target_version": {
      "type": "string"
    },
    "corrected_by": {
      "type": "string"
    },
    "grounds": {
      "type": "array",
      "minItems": 1
    },
    "correction_type": {
      "enum": [
        "source_correction",
        "interpretation_correction",
        "scope_correction",
        "authority_correction",
        "temporal_correction",
        "status_correction",
        "privacy_correction",
        "identity_correction"
      ]
    },
    "new_value": {},
    "valid_time_effect": {
      "type": "object",
      "required": [
        "valid_from"
      ],
      "properties": {
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retroactive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "minProperties": 1
    },
    "superseding_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "contest_status": {
      "enum": [
        "accepted",
        "partially_accepted",
        "contested",
        "rejected",
        "pending"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
